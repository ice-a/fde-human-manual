{
  "slug": "law-rights",
  "sections": [
    {
      "title": "劳动与工作",
      "items": [
        {
          "id": "law-rights-0-1",
          "title": "劳动合同要落到书面",
          "core": "口头约定在争议时最难证明。",
          "body": [
            "入职前确认合同主体、岗位和薪资。",
            "自己保留一份签字后的原件。"
          ],
          "tags": [
            "劳动",
            "合同"
          ]
        },
        {
          "id": "law-rights-0-2",
          "title": "试用期不是白干期",
          "core": "试用期也要签合同并支付工资。",
          "body": [
            "确认试用期长度与工资比例。",
            "试用期辞退也要说明理由。"
          ],
          "tags": [
            "劳动",
            "试用期"
          ]
        },
        {
          "id": "law-rights-0-3",
          "title": "加班要有记录",
          "core": "没有记录，加班费很难主张。",
          "body": [
            "保存排班、打卡和沟通记录。",
            "确认加班费或调休的计算方式。"
          ],
          "tags": [
            "劳动",
            "加班"
          ]
        },
        {
          "id": "law-rights-0-4",
          "title": "离职证明要拿到",
          "core": "它影响下一份工作的入职。",
          "body": [
            "离职时索取解除证明。",
            "确认社保和档案转移。"
          ],
          "tags": [
            "劳动",
            "离职"
          ]
        },
        {
          "id": "law-rights-0-5",
          "title": "社保尽量不断缴",
          "core": "断缴会影响医疗和购房资格。",
          "body": [
            "换工作间隙了解补缴规则。",
            "保留缴费记录备查。"
          ],
          "tags": [
            "社保",
            "权益"
          ]
        },
        {
          "id": "law-rights-0-6",
          "title": "工资条要逐项核对",
          "core": "工资条是核对社保和个税的依据。",
          "body": [
            "核对基本工资、绩效和扣款。",
            "发现异常当月提出。"
          ],
          "tags": [
            "劳动",
            "工资"
          ]
        },
        {
          "id": "law-rights-0-7",
          "title": "考勤记录自己留一份",
          "core": "发生争议时公司记录未必完整。",
          "body": [
            "保存打卡截图和排班通知。",
            "加班审批尽量留文字。"
          ],
          "tags": [
            "劳动",
            "证据"
          ]
        },
        {
          "id": "law-rights-0-8",
          "title": "调岗要双方协商",
          "core": "岗位属于合同内容。",
          "body": [
            "确认调岗后的薪资和地点。",
            "不同意时书面表达。"
          ],
          "tags": [
            "劳动",
            "调岗"
          ]
        },
        {
          "id": "law-rights-0-9",
          "title": "绩效制度要透明",
          "core": "考核标准应在事前明确。",
          "body": [
            "索要考核办法和权重。",
            "保留目标确认记录。"
          ],
          "tags": [
            "劳动",
            "绩效"
          ]
        },
        {
          "id": "law-rights-0-10",
          "title": "培训服务期看清成本",
          "core": "服务期违约金有上限。",
          "body": [
            "确认培训费用和分摊规则。",
            "签字前算清提前离职成本。"
          ],
          "tags": [
            "劳动",
            "培训"
          ]
        },
        {
          "id": "law-rights-0-11",
          "title": "竞业限制应有补偿",
          "core": "限制就业就要支付补偿。",
          "body": [
            "确认范围和期限。",
            "未支付补偿可主张解除。"
          ],
          "tags": [
            "劳动",
            "竞业"
          ]
        },
        {
          "id": "law-rights-0-12",
          "title": "年假按累计工龄算",
          "core": "休假天数与工龄相关。",
          "body": [
            "确认应休天数。",
            "未休年假有折价补偿。"
          ],
          "tags": [
            "劳动",
            "休假"
          ]
        },
        {
          "id": "law-rights-0-13",
          "title": "病假需要合规证明",
          "core": "证明形式影响工资待遇。",
          "body": [
            "按公司要求提供诊断材料。",
            "了解病假工资标准。"
          ],
          "tags": [
            "劳动",
            "病假"
          ]
        },
        {
          "id": "law-rights-0-14",
          "title": "孕期权益受保护",
          "core": "不能因怀孕降低待遇或辞退。",
          "body": [
            "保留孕期检查记录。",
            "了解产假和哺乳时间。"
          ],
          "tags": [
            "劳动",
            "权益"
          ]
        },
        {
          "id": "law-rights-0-15",
          "title": "集体合同覆盖全体",
          "core": "工会签订的合同对全员有效。",
          "body": [
            "了解是否适用所在岗位。",
            "个人合同不得低于集体标准。"
          ],
          "tags": [
            "劳动",
            "合同"
          ]
        },
        {
          "id": "law-rights-0-16",
          "title": "试用期辞退要举证",
          "core": "不能随意以不合适为由解除。",
          "body": [
            "要求说明具体理由。",
            "理由不成立可申请仲裁。"
          ],
          "tags": [
            "劳动",
            "试用期"
          ]
        },
        {
          "id": "law-rights-0-17",
          "title": "拖欠工资可以投诉",
          "core": "工资支付有明确时限。",
          "body": [
            "先催告并保留记录。",
            "向劳动监察反映。"
          ],
          "tags": [
            "劳动",
            "工资"
          ]
        },
        {
          "id": "law-rights-0-18",
          "title": "劳动争议先协商再仲裁",
          "core": "流程清楚才能少走弯路。",
          "body": [
            "整理证据和时间线。",
            "注意仲裁时效。"
          ],
          "tags": [
            "劳动",
            "仲裁"
          ]
        }
      ]
    },
    {
      "title": "居住与消费",
      "items": [
        {
          "id": "law-rights-1-1",
          "title": "租房合同逐条看",
          "core": "签字之前是谈判，签字之后是履行。",
          "body": [
            "确认租金、押金、维修责任与退租条件。",
            "把口头承诺写进补充条款。"
          ],
          "tags": [
            "租房",
            "合同"
          ]
        },
        {
          "id": "law-rights-1-2",
          "title": "押金退还留证据",
          "core": "入住时的状态决定退租时的争议。",
          "body": [
            "入住和退租都拍照录像。",
            "交接清单双方签字。"
          ],
          "tags": [
            "租房",
            "证据"
          ]
        },
        {
          "id": "law-rights-1-3",
          "title": "消费凭证要保存",
          "core": "发票和订单是维权的基础。",
          "body": [
            "大额消费索取发票。",
            "保存商品描述与承诺页面。"
          ],
          "tags": [
            "消费",
            "维权"
          ]
        },
        {
          "id": "law-rights-1-4",
          "title": "网购七天无理由有条件",
          "core": "定制、生鲜和拆封音像制品通常不适用。",
          "body": [
            "确认商品是否属于例外。",
            "保持商品完好并保留包装。"
          ],
          "tags": [
            "网购",
            "权益"
          ]
        },
        {
          "id": "law-rights-1-5",
          "title": "遇假货可主张赔偿",
          "core": "保留证据比当场争执更有效。",
          "body": [
            "先固定商品与宣传页面。",
            "通过平台或监管部门投诉。"
          ],
          "tags": [
            "消费",
            "维权"
          ]
        },
        {
          "id": "law-rights-1-6",
          "title": "房源产权先核实",
          "core": "不是所有出租人都有权出租。",
          "body": [
            "查看产权证明和身份证。",
            "确认是否存在抵押或查封。"
          ],
          "tags": [
            "租房",
            "核实"
          ]
        },
        {
          "id": "law-rights-1-7",
          "title": "中介费谁付要写清",
          "core": "口头约定最容易产生争议。",
          "body": [
            "确认金额和支付方。",
            "服务内容写进合同。"
          ],
          "tags": [
            "租房",
            "费用"
          ]
        },
        {
          "id": "law-rights-1-8",
          "title": "转租需房东同意",
          "core": "擅自转租可能导致合同解除。",
          "body": [
            "取得书面同意。",
            "确认新租客责任。"
          ],
          "tags": [
            "租房",
            "合同"
          ]
        },
        {
          "id": "law-rights-1-9",
          "title": "维修责任要划分",
          "core": "自然损耗和人为损坏不同。",
          "body": [
            "入住时记录设施状态。",
            "约定报修流程与承担方。"
          ],
          "tags": [
            "租房",
            "维修"
          ]
        },
        {
          "id": "law-rights-1-10",
          "title": "提前退租看条款",
          "core": "违约金通常写得很具体。",
          "body": [
            "确认通知期限和金额。",
            "尝试协商转租衔接。"
          ],
          "tags": [
            "租房",
            "退租"
          ]
        },
        {
          "id": "law-rights-1-11",
          "title": "物业费谁付要确认",
          "core": "租金之外还有隐藏成本。",
          "body": [
            "列明水电燃气和物业。",
            "交接时结清旧账。"
          ],
          "tags": [
            "租房",
            "费用"
          ]
        },
        {
          "id": "law-rights-1-12",
          "title": "保修期内找商家",
          "core": "不要自己先掏钱修。",
          "body": [
            "保留购买凭证。",
            "按保修条款申请服务。"
          ],
          "tags": [
            "消费",
            "保修"
          ]
        },
        {
          "id": "law-rights-1-13",
          "title": "预付费要谨慎",
          "core": "充值后商家可能关门。",
          "body": [
            "选择短期小额。",
            "保留合同和付款记录。"
          ],
          "tags": [
            "消费",
            "风险"
          ]
        },
        {
          "id": "law-rights-1-14",
          "title": "定金与订金不同",
          "core": "一个可罚没，一个可退。",
          "body": [
            "签字前确认用字。",
            "大额交易采用书面合同。"
          ],
          "tags": [
            "消费",
            "合同"
          ]
        },
        {
          "id": "law-rights-1-15",
          "title": "价格欺诈可投诉",
          "core": "虚构原价属于违法行为。",
          "body": [
            "截图促销页面。",
            "向平台或监管部门反映。"
          ],
          "tags": [
            "消费",
            "维权"
          ]
        },
        {
          "id": "law-rights-1-16",
          "title": "外卖异物先固定证据",
          "core": "拍照比争论更有效。",
          "body": [
            "保留实物和包装。",
            "通过平台申请处理。"
          ],
          "tags": [
            "消费",
            "证据"
          ]
        },
        {
          "id": "law-rights-1-17",
          "title": "旅游合同看清细节",
          "core": "行程、住宿和退改都要明确。",
          "body": [
            "确认自费项目和购物安排。",
            "留存宣传页面。"
          ],
          "tags": [
            "旅游",
            "合同"
          ]
        },
        {
          "id": "law-rights-1-18",
          "title": "售后承诺写下来",
          "core": "口头承诺难以兑现。",
          "body": [
            "让对方在聊天里确认。",
            "保存承诺截图。"
          ],
          "tags": [
            "消费",
            "证据"
          ]
        }
      ]
    },
    {
      "title": "财务与纠纷",
      "items": [
        {
          "id": "law-rights-2-1",
          "title": "借条要素要齐全",
          "core": "清楚比客气更重要。",
          "body": [
            "写明金额、期限、利息与身份信息。",
            "保留转账凭证。"
          ],
          "tags": [
            "借贷",
            "证据"
          ]
        },
        {
          "id": "law-rights-2-2",
          "title": "担保要格外谨慎",
          "core": "担保意味着替别人还债。",
          "body": [
            "看清是一般保证还是连带责任。",
            "不确定时不要签字。"
          ],
          "tags": [
            "担保",
            "风险"
          ]
        },
        {
          "id": "law-rights-2-3",
          "title": "民间借贷利率有上限",
          "core": "超出部分可能不受保护。",
          "body": [
            "核对当前司法保护上限。",
            "把已还款项逐笔记录。"
          ],
          "tags": [
            "借贷",
            "利率"
          ]
        },
        {
          "id": "law-rights-2-4",
          "title": "面对催收先核实",
          "core": "确认债务真实性与催收身份。",
          "body": [
            "要求对方提供债权凭证。",
            "保留通话与短信记录。"
          ],
          "tags": [
            "债务",
            "催收"
          ]
        },
        {
          "id": "law-rights-2-5",
          "title": "诉讼时效别错过",
          "core": "权利需要及时主张。",
          "body": [
            "记下权利受侵害的时间。",
            "在时效内催告或起诉。"
          ],
          "tags": [
            "诉讼",
            "时效"
          ]
        },
        {
          "id": "law-rights-2-6",
          "title": "转账备注写用途",
          "core": "备注能帮助还原借贷关系。",
          "body": [
            "写明借还款性质。",
            "避免只转不留言。"
          ],
          "tags": [
            "借贷",
            "证据"
          ]
        },
        {
          "id": "law-rights-2-7",
          "title": "共同借款要注明",
          "core": "谁借谁还要写清。",
          "body": [
            "确认债务人身份。",
            "担保人单独说明。"
          ],
          "tags": [
            "借贷",
            "合同"
          ]
        },
        {
          "id": "law-rights-2-8",
          "title": "分期要算总成本",
          "core": "低利率不等于低费用。",
          "body": [
            "把手续费算进年化成本。",
            "比较一次性还款方案。"
          ],
          "tags": [
            "借贷",
            "成本"
          ]
        },
        {
          "id": "law-rights-2-9",
          "title": "借贷平台看资质",
          "core": "不合规平台风险极高。",
          "body": [
            "核验备案和主体信息。",
            "不向陌生账户付款。"
          ],
          "tags": [
            "借贷",
            "风险"
          ]
        },
        {
          "id": "law-rights-2-10",
          "title": "债务重组要书面",
          "core": "口头展期容易反复。",
          "body": [
            "写明新期限和金额。",
            "保留还款凭证。"
          ],
          "tags": [
            "债务",
            "协议"
          ]
        },
        {
          "id": "law-rights-2-11",
          "title": "强制执行有期限",
          "core": "判决生效后要及时申请。",
          "body": [
            "记录生效日期。",
            "了解财产查控流程。"
          ],
          "tags": [
            "诉讼",
            "执行"
          ]
        },
        {
          "id": "law-rights-2-12",
          "title": "财产保全了解门槛",
          "core": "防止对方转移资产。",
          "body": [
            "准备初步证据。",
            "了解担保要求。"
          ],
          "tags": [
            "诉讼",
            "保全"
          ]
        },
        {
          "id": "law-rights-2-13",
          "title": "小额诉讼更省时",
          "core": "标的较小时流程简化。",
          "body": [
            "确认是否适用。",
            "准备完整证据。"
          ],
          "tags": [
            "诉讼",
            "流程"
          ]
        },
        {
          "id": "law-rights-2-14",
          "title": "证据链要完整",
          "core": "孤立截图证明力有限。",
          "body": [
            "保留原始载体。",
            "按时间顺序整理。"
          ],
          "tags": [
            "证据",
            "整理"
          ]
        },
        {
          "id": "law-rights-2-15",
          "title": "录音证据要合法取得",
          "core": "侵犯他人隐私的录音可能无效。",
          "body": [
            "记录对话背景和身份。",
            "保留原始文件。"
          ],
          "tags": [
            "证据",
            "录音"
          ]
        },
        {
          "id": "law-rights-2-16",
          "title": "聊天记录不要删",
          "core": "后续可能成为关键证据。",
          "body": [
            "备份重要对话。",
            "保留账号和原始设备。"
          ],
          "tags": [
            "证据",
            "记录"
          ]
        },
        {
          "id": "law-rights-2-17",
          "title": "催告可中断时效",
          "core": "及时主张权利很重要。",
          "body": [
            "用可留痕方式催告。",
            "保存送达证据。"
          ],
          "tags": [
            "诉讼",
            "时效"
          ]
        },
        {
          "id": "law-rights-2-18",
          "title": "调解协议要签字",
          "core": "调解结果同样具有约束力。",
          "body": [
            "看清履行期限。",
            "必要时申请司法确认。"
          ],
          "tags": [
            "调解",
            "协议"
          ]
        }
      ]
    },
    {
      "title": "人身与家庭",
      "items": [
        {
          "id": "law-rights-3-1",
          "title": "事故现场先固定证据",
          "core": "拍照和报警比争论更有用。",
          "body": [
            "拍摄现场、车牌与伤情。",
            "及时报警并取得事故认定。"
          ],
          "tags": [
            "事故",
            "证据"
          ]
        },
        {
          "id": "law-rights-3-2",
          "title": "工伤认定有时限",
          "core": "申请越早越容易核实。",
          "body": [
            "保留劳动关系与受伤证据。",
            "按规定时间提交申请。"
          ],
          "tags": [
            "工伤",
            "时限"
          ]
