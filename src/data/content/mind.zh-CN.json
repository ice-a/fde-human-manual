{
  "slug": "mind",
  "sections": [
    {
      "title": "看清情绪",
      "items": [
        {
          "id": "mind-0-1",
          "title": "先给情绪命名",
          "core": "说得出名字，就少一半被裹挟。",
          "body": [
            "用具体词描述：焦虑、委屈、羞耻。",
            "区分情绪和事实。"
          ],
          "tags": [
            "情绪",
            "识别"
          ]
        },
        {
          "id": "mind-0-2",
          "title": "把想法和事实分开",
          "core": "脑子里的判断不等于发生的事。",
          "body": [
            "写下事实、推测和未知。",
            "给推测找反例。"
          ],
          "tags": [
            "认知",
            "判断"
          ]
        },
        {
          "id": "mind-0-3",
          "title": "情绪不是指令",
          "core": "感觉强烈不代表必须照做。",
          "body": [
            "先承认感受。",
            "再决定是否行动。"
          ],
          "tags": [
            "情绪",
            "边界"
          ]
        },
        {
          "id": "mind-0-4",
          "title": "记录触发点",
          "core": "重复出现的刺激往往有规律。",
          "body": [
            "记下时间、场景和身体反应。",
            "回看时找共同点。"
          ],
          "tags": [
            "记录",
            "觉察"
          ]
        },
        {
          "id": "mind-0-5",
          "title": "允许情绪存在",
          "core": "压制常常让它更久。",
          "body": [
            "给自己一段不评判的时间。",
            "用呼吸或书写陪它过去。"
          ],
          "tags": [
            "接纳",
            "调节"
          ]
        },
        {
          "id": "mind-0-6",
          "title": "留意身体信号",
          "core": "情绪常先反映在身体上。",
          "body": [
            "注意心跳、肩颈和胃部。",
            "记录出现场景。"
          ],
          "tags": [
            "情绪",
            "身体"
          ]
        },
        {
          "id": "mind-0-7",
          "title": "给情绪强度打分",
          "core": "量化能降低被淹没感。",
          "body": [
            "用 1 到 10 分标注。",
            "观察高峰何时出现。"
          ],
          "tags": [
            "情绪",
            "记录"
          ]
        },
        {
          "id": "mind-0-8",
          "title": "给情绪设一个时限",
          "core": "无限蔓延的情绪最消耗。",
          "body": [
            "约定一段专注感受的时间。",
            "时间到就做一件小事。"
          ],
          "tags": [
            "情绪",
            "调节"
          ]
        },
        {
          "id": "mind-0-9",
          "title": "区分需要与想法",
          "core": "想法未必是事实。",
          "body": [
            "写下「我需要什么」。",
            "把推测单独标注。"
          ],
          "tags": [
            "认知",
            "觉察"
          ]
        },
        {
          "id": "mind-0-10",
          "title": "识别羞耻感",
          "core": "羞耻常伪装成拖延。",
          "body": [
            "说出「我觉得自己不够好」。",
            "把它与事实分开。"
          ],
          "tags": [
            "情绪",
            "识别"
          ]
        },
        {
          "id": "mind-0-11",
          "title": "愤怒背后常有需求",
          "core": "生气说明边界被触碰。",
          "body": [
            "问自己被侵犯了什么。",
            "把需求说出来。"
          ],
          "tags": [
            "愤怒",
            "需求"
          ]
        },
        {
          "id": "mind-0-12",
          "title": "记录成功应对经验",
          "core": "低谷时需要证据。",
          "body": [
            "写下过去怎么熬过来。",
            "保留可复用的方法。"
          ],
          "tags": [
            "记录",
            "证据"
          ]
        },
        {
          "id": "mind-0-13",
          "title": "不必急着解决",
          "core": "先稳定再处理。",
          "body": [
            "允许自己待一会儿。",
            "等情绪回落再决定。"
          ],
          "tags": [
            "情绪",
            "节奏"
          ]
        },
        {
          "id": "mind-0-14",
          "title": "允许矛盾感",
          "core": "同时喜欢和讨厌是正常的。",
          "body": [
            "不必强行统一感受。",
            "分别写下两面。"
          ],
          "tags": [
            "情绪",
            "接纳"
          ]
        },
        {
          "id": "mind-0-15",
          "title": "命名细微情绪",
          "core": "越精确越容易处理。",
          "body": [
            "从「烦」细分到「失望」。",
            "用具体词表达。"
          ],
          "tags": [
            "情绪",
            "词汇"
          ]
        },
        {
          "id": "mind-0-16",
          "title": "情绪不等于身份",
          "core": "你不是某种情绪本身。",
          "body": [
            "用「我现在感到」开头。",
            "不要把感受当结论。"
          ],
          "tags": [
            "认知",
            "边界"
          ]
        },
        {
          "id": "mind-0-17",
          "title": "观察触发频率",
          "core": "重复出现的刺激有规律。",
          "body": [
            "记录时间、人和事件。",
            "回看共同点。"
          ],
          "tags": [
            "记录",
            "觉察"
          ]
        },
        {
          "id": "mind-0-18",
          "title": "建立自己的情绪词汇",
          "core": "词汇越丰富越不被裹挟。",
          "body": [
            "每天记一个情绪词。",
            "用在真实感受上。"
          ],
          "tags": [
            "情绪",
            "词汇"
          ]
        }
      ]
    },
    {
      "title": "日常调节",
      "items": [
        {
          "id": "mind-1-1",
          "title": "呼吸是最快的落地练习",
          "core": "延长呼气能让身体降速。",
          "body": [
            "慢慢吸气、更长地呼气。",
            "重复几轮再处理事情。"
          ],
          "tags": [
            "调节",
            "身体"
          ]
        },
        {
          "id": "mind-1-2",
          "title": "睡眠是情绪底座",
          "core": "长期缺睡会放大一切波动。",
          "body": [
            "固定起床时间。",
            "睡前一小时减少刺激。"
          ],
          "tags": [
            "睡眠",
            "基础"
          ]
        },
        {
          "id": "mind-1-3",
          "title": "身体动起来",
          "core": "活动能改变情绪的化学环境。",
          "body": [
            "从十分钟的散步开始。",
            "选择能坚持的强度。"
          ],
          "tags": [
            "运动",
            "情绪"
          ]
        },
        {
          "id": "mind-1-4",
          "title": "减少反刍",
          "core": "反复想同一件事不会带来新信息。",
          "body": [
            "把想法写成问题。",
            "限定一个思考时间。"
          ],
          "tags": [
            "反刍",
            "方法"
          ]
        },
        {
          "id": "mind-1-5",
          "title": "晒太阳和规律饮食",
          "core": "基础节律影响情绪稳定。",
          "body": [
            "白天接触自然光。",
            "不要靠暴饮暴食调节。"
          ],
          "tags": [
            "节律",
            "生活"
          ]
        },
        {
          "id": "mind-1-6",
          "title": "固定起床时间",
          "core": "比固定入睡时间更有效。",
          "body": [
            "周末也别差太多。",
            "起床后接触光线。"
          ],
          "tags": [
            "睡眠",
            "节律"
          ]
        },
        {
          "id": "mind-1-7",
          "title": "白天安排活动",
          "core": "身体活动帮助夜间入睡。",
          "body": [
            "不必高强度。",
            "避免临睡前剧烈运动。"
          ],
          "tags": [
            "睡眠",
            "活动"
          ]
        },
        {
          "id": "mind-1-8",
          "title": "减少咖啡因摄入",
          "core": "下午之后影响睡眠。",
          "body": [
            "留意个人敏感时间。",
            "逐步减少而不是突然停。"
          ],
          "tags": [
            "睡眠",
            "饮食"
          ]
        },
        {
          "id": "mind-1-9",
          "title": "睡前写下待办",
          "core": "把念头从脑子里移出去。",
          "body": [
            "只写明天第一步。",
            "写完就放下。"
          ],
          "tags": [
            "睡眠",
            "记录"
          ]
        },
        {
          "id": "mind-1-10",
          "title": "练习延长呼气",
          "core": "呼气比吸气长更放松。",
          "body": [
            "数到四吸、数到六呼。",
            "重复几轮。"
          ],
          "tags": [
            "调节",
            "呼吸"
          ]
        },
        {
          "id": "mind-1-11",
          "title": "渐进放松身体",
          "core": "从脚到头依次紧绷再放松。",
          "body": [
            "每个部位保持几秒。",
            "注意放松后的感觉。"
          ],
          "tags": [
            "调节",
            "身体"
          ]
        },
        {
          "id": "mind-1-12",
          "title": "留一段正念时间",
          "core": "不评判地观察当下。",
          "body": [
            "从三分钟开始。",
            "走神就温和拉回。"
          ],
          "tags": [
            "调节",
            "正念"
          ]
        },
        {
          "id": "mind-1-13",
          "title": "整理身边空间",
          "core": "环境有序能降低负荷。",
          "body": [
            "只整理一小块。",
            "不追求完美。"
          ],
          "tags": [
            "环境",
            "情绪"
          ]
        },
        {
          "id": "mind-1-14",
          "title": "写下担心并分类",
          "core": "区分能控制和不能控制。",
          "body": [
            "把能做的列成一步。",
            "不能放的先放着。"
          ],
          "tags": [
            "认知",
            "书写"
          ]
        },
        {
          "id": "mind-1-15",
          "title": "限制信息摄入",
          "core": "坏消息会放大焦虑。",
          "body": [
            "设定查看新闻的时段。",
            "睡前不刷冲突性内容。"
          ],
          "tags": [
            "焦虑",
            "信息"
          ]
        },
        {
          "id": "mind-1-16",
          "title": "规律饮食",
          "core": "血糖波动影响情绪。",
          "body": [
            "不要靠甜食提神。",
            "按时吃正餐。"
          ],
          "tags": [
            "生活",
            "饮食"
          ]
        },
        {
          "id": "mind-1-17",
          "title": "用社交补充能量",
          "core": "不是所有社交都消耗。",
          "body": [
            "找能放松的人。",
            "说明你只是想聊聊。"
          ],
          "tags": [
            "关系",
            "支持"
          ]
        },
        {
          "id": "mind-1-18",
          "title": "保留兴趣时间",
          "core": "兴趣是情绪的出口。",
          "body": [
            "每周留一段固定时间。",
            "不以产出为目标。"
          ],
          "tags": [
            "兴趣",
            "节奏"
          ]
        }
      ]
    },
    {
      "title": "面对低落",
      "items": [
        {
          "id": "mind-2-1",
          "title": "低落时只做最小动作",
          "core": "目标过大反而会停摆。",
          "body": [
            "选一件五分钟能完成的事。",
            "完成后不追加要求。"
          ],
          "tags": [
            "低落",
            "行动"
          ]
        },
        {
          "id": "mind-2-2",
          "title": "写下问题而不是反复想",
          "core": "写下来就变成可处理的题目。",
          "body": [
            "列出已知、未知和下一步。",
            "把大问题拆小。"
          ],
          "tags": [
            "书写",
            "方法"
          ]
        },
        {
          "id": "mind-2-3",
          "title": "不要和自我较劲",
          "core": "自责不会提高效率。",
          "body": [
            "把「我怎么这样」换成「下次怎么做」。",
            "给自己和别人同样的宽容。"
          ],
          "tags": [
            "自责",
            "心态"
          ]
        },
        {
          "id": "mind-2-4",
          "title": "允许休息",
          "core": "休息不是失败的证据。",
          "body": [
            "提前安排休息而不是撑到崩溃。",
            "休息后回看状态。"
          ],
          "tags": [
            "休息",
            "边界"
          ]
        },
        {
          "id": "mind-2-5",
          "title": "保留希望的依据",
          "core": "低谷时需要具体证据而不是空话。",
          "body": [
            "记录过去恢复的经历。",
            "留意正在变好的小信号。"
          ],
          "tags": [
            "希望",
            "证据"
          ]
        },
        {
          "id": "mind-2-6",
          "title": "把标准降到可执行",
          "core": "低落时完美标准会让人停摆。",
          "body": [
            "只要求完成不要求质量。",
            "完成就算数。"
          ],
          "tags": [
            "低落",
            "行动"
          ]
        },
        {
          "id": "mind-2-7",
          "title": "一次只做一件",
          "core": "选择过多会加重无力感。",
          "body": [
            "写下唯一要做的事。",
            "做完再想下一件。"
          ],
          "tags": [
            "低落",
            "行动"
          ]
        },
        {
          "id": "mind-2-8",
          "title": "记录完成而不是感受",
          "core": "感受会骗人，记录不会。",
          "body": [
            "写下一件做成的事。",
            "睡前回看。"
          ],
          "tags": [
            "低落",
            "记录"
          ]
        },
        {
          "id": "mind-2-9",
          "title": "找人说说",
          "core": "不必等到状态好才开口。",
          "body": [
            "说明你想被听还是被帮。",
            "允许对方不知道怎么答。"
          ],
          "tags": [
            "支持",
            "表达"
          ]
        },
        {
          "id": "mind-2-10",
          "title": "避免重大决定",
          "core": "低谷时判断容易偏差。",
          "body": [
            "把决定推迟到状态恢复。",
            "先处理日常事务。"
          ],
          "tags": [
            "低落",
            "决定"
          ]
        },
        {
          "id": "mind-2-11",
          "title": "保留日常节律",
          "core": "吃饭睡觉出门是底座。",
          "body": [
            "先恢复最基本节奏。",
            "不追求额外目标。"
          ],
          "tags": [
            "低落",
            "节律"
          ]
        },
        {
          "id": "mind-2-12",
          "title": "减少长时间独处",
          "core": "独处会放大反刍。",
          "body": [
            "去有人在的地方。",
            "不必社交，待着就行。"
          ],
          "tags": [
            "低落",
            "环境"
          ]
        },
        {
          "id": "mind-2-13",
          "title": "不要用酒精助眠",
          "core": "它会破坏睡眠结构。",
          "body": [
            "短期放松换来长期波动。",
            "需要时寻求替代方法。"
          ],
          "tags": [
            "低落",
            "生活"
          ]
        },
        {
          "id": "mind-2-14",
          "title": "给自己一段时间",
          "core": "恢复不是一瞬间的事。",
          "body": [
            "不设过短期限。",
            "允许反复。"
          ],
          "tags": [
            "低落",
            "耐心"
          ]
        },
        {
          "id": "mind-2-15",
          "title": "回顾过去的恢复",
          "core": "证据比鼓励更有用。",
          "body": [
            "写下曾经走出来的经历。",
            "提炼当时有效的动作。"
          ],
          "tags": [
            "希望",
            "证据"
          ]
        },
        {
          "id": "mind-2-16",
          "title": "寻找小信号",
          "core": "变化常常先出现在小事上。",
          "body": [
            "留意睡眠和食欲。",
            "记录微小的好转。"
          ],
          "tags": [
            "希望",
            "观察"
          ]
        },
        {
          "id": "mind-2-17",
          "title": "做一次专业评估",
          "core": "持续低落值得被认真对待。",
          "body": [
            "记录持续时间和影响。",
            "咨询专业人士。"
          ],
          "tags": [
            "求助",
            "专业"
          ]
        },
        {
          "id": "mind-2-18",
          "title": "准备危机预案",
          "core": "最坏时刻也需要方案。",
          "body": [
            "写下可联系的人。",
            "保存危机热线。"
          ],
          "tags": [
            "危机",
            "准备"
          ]
        }
      ]
    },
    {
      "title": "关系与求助",
      "items": [
        {
          "id": "mind-3-1",
          "title": "说出感受而不是指责",
          "core": "「我感到…」比「你总是…」有效。",
          "body": [
            "描述具体行为。",
            "提出明确请求。"
          ],
          "tags": [
            "表达",
            "关系"
          ]
        },
        {
          "id": "mind-3-2",
          "title": "不必替所有人负责",
          "core": "边界是长期关系的前提。",
          "body": [
            "分清谁的问题由谁解决。",
            "帮忙前先估自己的余力。"
          ],
          "tags": [
            "边界",
            "关系"
          ]
        },
        {
          "id": "mind-3-3",
          "title": "比较会偷走满足感",
          "core": "别人的进度不是你的标尺。",
          "body": [
            "减少暴露在比较场景。",
            "用自己的上一次作参照。"
          ],
          "tags": [
            "比较",
            "心态"
          ]
        },
        {
          "id": "mind-3-4",
          "title": "社会支持是真实资源",
          "core": "不必独自扛全部。",
          "body": [
            "说出具体需要什么帮助。",
            "也允许自己被照顾。"
          ],
          "tags": [
            "支持",
            "求助"
          ]
        },
        {
          "id": "mind-3-5",
          "title": "识别需要专业帮助的信号",
          "core": "持续、严重、影响功能就该求助。",
          "body": [
            "留意睡眠、食欲和日常功能。",
            "出现危机想法立即求助。"
          ],
          "tags": [
            "求助",
            "信号"
          ]
        },
        {
          "id": "mind-3-6",
          "title": "请求要说具体",
