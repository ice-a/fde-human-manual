    {
      "title": "协作与表达",
      "items": [
        {
          "id": "get-along-7-1",
          "title": "先说结论，再说理由",
          "core": "信息密度决定沟通效率。",
          "body": [
            "第一句给判断。",
            "后续补充依据和例子。"
          ],
          "tags": [
            "表达",
            "汇报"
          ],
          "sourceUrl": "https://github.com/kkk-bot/HowToGetAlong"
        },
        {
          "id": "get-along-7-2",
          "title": "把请求写成可执行项",
          "core": "模糊的请求等于没有请求。",
          "body": [
            "写清要做什么、什么时候要。",
            "标明优先级。"
          ],
          "tags": [
            "协作",
            "请求"
          ],
          "sourceUrl": "https://github.com/kkk-bot/HowToGetAlong"
        },
        {
          "id": "get-along-7-3",
          "title": "复述确认避免理解偏差",
          "core": "确认成本远低于返工成本。",
          "body": [
            "用自己的话复述一遍。",
            "把分歧点单独列出。"
          ],
          "tags": [
            "沟通",
            "确认"
          ],
          "sourceUrl": "https://github.com/kkk-bot/HowToGetAlong"
        },
        {
          "id": "get-along-7-4",
          "title": "会上发言要短且有观点",
          "core": "长篇铺垫容易失去注意力。",
          "body": [
            "一个观点配一个例子。",
            "把细节留到会后。"
          ],
          "tags": [
            "会议",
            "表达"
          ],
          "sourceUrl": "https://github.com/kkk-bot/HowToGetAlong"
        },
        {
          "id": "get-along-7-5",
          "title": "反对意见要对事",
          "core": "把「我不同意你」换成「这个方案有个风险」。",
          "body": [
            "给出可验证的理由。",
            "附上你的替代方案。"
          ],
          "tags": [
            "冲突",
            "协作"
          ],
          "sourceUrl": "https://github.com/kkk-bot/HowToGetAlong"
        },
        {
          "id": "get-along-7-6",
          "title": "书面沟通要能独立读懂",
          "core": "脱离上下文仍成立，才算写清楚。",
          "body": [
            "补上背景和结论。",
            "避免只有当事人懂的简称。"
          ],
          "tags": [
            "写作",
            "协作"
          ],
          "sourceUrl": "https://github.com/kkk-bot/HowToGetAlong"
        },
        {
          "id": "get-along-7-7",
          "title": "同步进度不要等到被问",
          "core": "主动同步能减少大量追问。",
          "body": [
            "固定节奏给简短更新。",
            "风险提前暴露。"
          ],
          "tags": [
            "协作",
            "进度"
          ],
          "sourceUrl": "https://github.com/kkk-bot/HowToGetAlong"
        },
        {
          "id": "get-along-7-8",
          "title": "给反馈留时间窗口",
          "core": "当场未必能消化。",
          "body": [
